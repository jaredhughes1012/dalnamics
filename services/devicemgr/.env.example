# Used by `make run-devicemgr` to run devicemgr on the host against the compose postgres.
DEVICEMGR_ADDR=:8081
DATABASE_URL=postgres://dalnamics:dalnamics@localhost:5433/dalnamics?sslmode=disable
DEVICEMGR_TOKEN=local-devicemgr-token-not-for-production-use
# The compose broker on the host port. The broker authenticates clients by
# calling devicemgr at devicemgr:8081, so device traffic needs devicemgr in compose.
DEVICEMGR_MQTT_URL=mqtt://localhost:1883
DEVICEMGR_MQTT_PASSWORD=local-devicemgr-mqtt-password-not-for-production
